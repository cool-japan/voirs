//! Binaural rendering example with multiple sound sources
//!
//! This example demonstrates:
//! - Creating a binaural renderer
//! - Adding multiple sound sources at different positions
//! - Real-time binaural audio rendering
//!
//! Run with: cargo run --example binaural_rendering --no-default-features

use std::sync::Arc;
use voirs_spatial::{BinauralConfig, BinauralRenderer, HrtfDatabase, Position3D};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    println!("=== Binaural Rendering Example ===\n");

    // Create binaural rendering configuration
    let config = BinauralConfig {
        sample_rate: 48000,
        buffer_size: 512,
        hrir_length: 200,
        max_sources: 8,
        use_gpu: false,
        crossfade_duration: 0.05,
        quality_level: 0.8,
        enable_distance_modeling: true,
        enable_air_absorption: true,
        near_field_distance: 0.2,
        far_field_distance: 10.0,
        optimize_for_latency: true,
    };

    println!("✓ Created binaural configuration");
    println!("  Sample rate: {} Hz", config.sample_rate);
    println!("  Max sources: {}", config.max_sources);
    println!("  Quality level: {:.0}%\n", config.quality_level * 100.0);

    // Create HRTF database and renderer
    let hrtf_db = Arc::new(HrtfDatabase::default());
    let mut renderer = BinauralRenderer::new(config, hrtf_db).await?;
    println!("✓ Created binaural renderer with HRTF database\n");

    // Define multiple sound sources at different positions
    let sources = vec![
        ("front", Position3D::new(0.0, 2.0, 0.0), 440.0), // Front
        ("left", Position3D::new(-1.5, 1.0, 0.0), 523.0), // Left
        ("right", Position3D::new(1.5, 1.0, 0.0), 659.0), // Right
        ("above", Position3D::new(0.0, 1.0, 1.0), 784.0), // Above
    ];

    println!("Adding {} sound sources:", sources.len());

    for (name, position, frequency) in &sources {
        // Generate audio for this source
        let audio: Vec<f32> = (0..512)
            .map(|i| {
                let t = i as f32 / 48000.0;
                (2.0 * std::f32::consts::PI * frequency * t).sin() * 0.2
            })
            .collect();

        // Add source to renderer
        renderer
            .add_source(name.to_string(), audio, *position)
            .await?;

        println!(
            "  ✓ {} - ({:.1}, {:.1}, {:.1}) - {}Hz",
            name, position.x, position.y, position.z, frequency
        );
    }

    println!("\n✓ All sources added to renderer\n");

    // Process binaural audio frame
    println!("Processing binaural audio frame...");

    let listener_pos = Position3D::new(0.0, 0.0, 0.0);
    let listener_orientation = Position3D::new(0.0, 1.0, 0.0); // Facing forward

    let binaural_output = renderer
        .process_frame(listener_pos, listener_orientation)
        .await?;

    println!("✓ Binaural frame processed successfully!");
    println!("  Output channels: 2 (stereo)");
    println!("  Frame size: {} samples\n", binaural_output.left.len());

    // Get performance metrics
    let metrics = renderer.get_metrics().await;
    println!("Performance Metrics:");
    println!("  Processing time: {:.2}ms", metrics.processing_time_ms);
    println!("  Active sources: {}", metrics.active_sources);
    println!("  CPU usage: {:.1}%", metrics.cpu_usage * 100.0);
    println!("  Crossfade count: {}", metrics.crossfade_count);

    // Analyze output
    let left_energy: f32 = binaural_output.left.iter().map(|&x| x * x).sum();
    let right_energy: f32 = binaural_output.right.iter().map(|&x| x * x).sum();

    println!("\nOutput Analysis:");
    println!(
        "  Left channel RMS: {:.3}",
        (left_energy / binaural_output.left.len() as f32).sqrt()
    );
    println!(
        "  Right channel RMS: {:.3}",
        (right_energy / binaural_output.right.len() as f32).sqrt()
    );
    println!(
        "  Balance: {:.1}dB",
        10.0 * (right_energy / left_energy.max(0.001)).log10()
    );

    println!("\n✅ Example completed successfully!");
    println!("\nNote: In a real application, you would:");
    println!("  - Write the output to an audio device or file");
    println!("  - Update source positions in real-time");
    println!("  - Process continuous audio frames in a loop");

    Ok(())
}
